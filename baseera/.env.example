# ─────────────────────────────────────────────────────────────────────────────
# Baseera — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────

# Centralized AI Gateway / LiteLLM Proxy URL
# To connect via LiteLLM Proxy: http://localhost:4000/v1
# To connect directly to Groq API: https://api.groq.com/openai/v1
VITE_AI_BASE_URL=https://api.groq.com/openai/v1

# API Key for LiteLLM Gateway or Direct Inference Provider
VITE_AI_API_KEY=

# Default inference model identifier
VITE_AI_MODEL=qwen/qwen3.8-27b
